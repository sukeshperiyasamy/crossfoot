---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import TrustStrip from '../components/TrustStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import MiniRegister from '../components/MiniRegister.astro';

const problems = [
  {
    title: 'Dispatched, never billed',
    body: 'Month-end orders rush out on manual delivery challans. Some never become tax invoices — and nobody notices until the next stock count, when the money is months late and the trail is cold.',
  },
  {
    title: 'Tally says one thing. The godown says another.',
    body: 'Bin cards, gate registers and Tally drift apart all month. Every difference gets investigated by hand — or quietly carried forward, again, into next month’s reconciliation.',
  },
  {
    title: 'Close takes twenty days',
    body: 'Four exports, three VLOOKUP sheets and one person who knows how it all fits. Management finally sees the numbers when they are too old to act on.',
  },
];

const ladder = [
  {
    step: '01',
    name: '4-Day Diagnostic',
    price: '₹1,999',
    unit: '+ GST · introductory fixed fee',
    body: 'A forensic four-day audit of one reconciliation workflow. You receive a clean master dataset, a traceable exception register and an executive summary.',
    href: '/diagnostic',
    cta: 'See what you get',
    featured: true,
  },
  {
    step: '02',
    name: 'Implementation Sprint',
    price: '₹25,000+',
    unit: 'fixed after scoping',
    body: 'The diagnostic becomes permanent: a locally-run, one-click pipeline that reconciles every month and flags exceptions automatically.',
    href: '/pricing',
    cta: 'How sprints work',
    featured: false,
  },
  {
    step: '03',
    name: 'Monthly MIS Retainer',
    price: '₹5,000/mo+',
    unit: 'only if you need it',
    body: 'We run the monthly close, verify exceptions and hand your management a verified numbers pack — before the 5th, every month.',
    href: '/pricing',
    cta: 'Retainer details',
    featured: false,
  },
];

const beforeAfter = [
  ['Data architecture', 'Dispatches in Excel, ledgers in Tally, truth nowhere', 'One reconciled master dataset with documented matching rules'],
  ['Exceptions', 'Carried forward month after month, unexplained', 'Every exception isolated, classified and traced to source rows'],
  ['Month-end', '3–5 days of manual matching, 20-day close', 'One-click refresh; verified numbers by day 3'],
  ['Key-person risk', 'It all lives in one clerk’s head and one fragile sheet', 'Documented workflow your own team can run'],
];

const faqs = [
  {
    q: '“Tally already does reconciliation.”',
    a: 'Tally reconciles what is inside Tally — bank statements, vouchers, ledgers. It cannot see the gate register, the transporter’s LR or the bin card. We audit exactly that gap: the records that live outside your accounting software.',
  },
  {
    q: '“My accountant already handles this.”',
    a: 'Your CA handles statutory work — GST, filings, audit prep. Nobody audits the operational gap between the godown gate and the sales register. We do, and we make your CA’s job faster with cleaner source data.',
  },
  {
    q: '“Is my data safe?”',
    a: 'A mutual NDA is signed before we receive anything. Processing is 100% offline on an encrypted machine — no cloud uploads, no public AI tools, read-only files, and deletion 14 days after handover.',
  },
];
---

<Base
  title="Crossfoot — Dispatch-to-Invoice Reconciliation for Distributors | Coimbatore & Chennai"
  description="A fixed-scope 4-day diagnostic that matches your dispatch records against your Tally sales register and flags every unbilled challan, quantity mismatch and duplicate bill — with row-level proof. Offline processing, NDA first."
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.35]"
      style="background-image: repeating-linear-gradient(to bottom, transparent 0 39px, rgba(22,33,27,0.045) 39px 40px);"
      aria-hidden="true"
    >
    </div>
    <div class="container-x relative grid gap-12 py-16 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:py-24">
      <div>
        <p class="eyebrow">Crossfoot · Reconciliation & Reporting Practice · Tamil Nadu</p>
        <h1 class="display-1 mt-5">
          Goods leave your godown on a challan. Does every one of them come back as an
          <em class="text-match-700 not-italic underline decoration-match-300 decoration-2 underline-offset-8">invoice</em>?
        </h1>
        <p class="lead mt-6 max-w-xl">
          A fixed-scope, 4-day reconciliation diagnostic for distributors and manufacturers using
          Tally. We match your dispatch records against your sales register and flag every unbilled
          challan, quantity mismatch and duplicate bill — with row-level proof. No new software. No
          cloud uploads. NDA signed first.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="btn-primary">
            Book a 15-minute call
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
          <a href="/proof" class="btn-secondary">See a sample exception report</a>
        </div>
        <p class="mt-7 font-mono text-[11.5px] tracking-[0.12em] text-ink/50 uppercase">
          ₹1,999 introductory fee · 4 business days · 100% offline · Mutual NDA
        </p>
      </div>
      <div class="lg:pl-4">
        <MiniRegister />
      </div>
    </div>
  </section>

  <!-- Spec band -->
  <section class="border-y border-line bg-ink-900">
    <div class="container-x flex flex-wrap items-center justify-center gap-x-8 gap-y-3 py-4">
      {
        ['One workflow', 'Up to 2 files · 100,000 rows', '4 business days', '₹1,999 + GST', 'Fee 100% credited to implementation'].map(
          (s) => (
            <span class="font-mono text-[11px] tracking-[0.18em] text-paper-50/70 uppercase">{s}</span>
          )
        )
      }
    </div>
  </section>

  <!-- ============ PROBLEM ============ -->
  <section class="py-20 lg:py-24">
    <div class="container-x">
      <SectionHead
        index="01"
        eyebrow="The problem"
        title="The month doesn’t close. It unravels."
        sub="Nobody sets out to lose track of dispatches. It happens one manual challan, one absent clerk and one overwritten formula at a time — until the gap between the godown and the books is nobody’s job."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          problems.map((p, i) => (
            <div class="card card-pad">
              <span class="font-mono text-[11px] tracking-[0.2em] text-ink/35 uppercase">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="display-3 mt-3">{p.title}</h3>
              <p class="body-text mt-3">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ OFFER LADDER ============ -->
  <section class="border-y border-line bg-paper-100 py-20 lg:py-24">
    <div class="container-x">
      <SectionHead
        index="02"
        eyebrow="What we do"
        title="One ladder. Three steps. No hourly billing."
        sub="You buy outcomes, not hours of Excel work. Start with the diagnostic — if the findings justify automation, the entire fee is credited toward the build."
      />
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {
          ladder.map((tier) => (
            <a
              href={tier.href}
              class:list={[
                'card card-pad group flex flex-col transition-shadow hover:shadow-[0_2px_12px_rgba(22,33,27,0.07)]',
                tier.featured && 'border-match-600 border-2',
              ]}
            >
              <div class="flex items-center justify-between">
                <span class="font-mono text-[11px] tracking-[0.2em] text-ink/40 uppercase">{tier.step}</span>
                {tier.featured && <span class="chip chip-match">Start here</span>}
              </div>
              <h3 class="display-3 mt-4">{tier.name}</h3>
              <p class="mt-3">
                <span class="font-display text-3xl font-semibold tracking-tight text-ink">{tier.price}</span>
                <span class="ml-2 font-mono text-[11px] tracking-[0.1em] text-ink/50 uppercase">{tier.unit}</span>
              </p>
              <p class="body-text mt-4 flex-1">{tier.body}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-[13.5px] font-semibold text-match-700">
                {tier.cta}
                <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          ))
        }
      </div>
      <p class="mt-6 text-center font-mono text-[11.5px] tracking-[0.1em] text-ink/50 uppercase">
        Proceed to implementation within 14 days of the diagnostic → 100% of ₹1,999 credited
      </p>
    </div>
  </section>

  <!-- ============ BEFORE / AFTER ============ -->
  <section class="py-20 lg:py-24">
    <div class="container-x">
      <SectionHead
        index="03"
        eyebrow="The difference"
        title="What changes after four days"
      />
      <div class="card mt-12 overflow-hidden">
        <div class="grid sm:grid-cols-[0.9fr_1.4fr_1.4fr]">
          <div class="hidden border-b border-line bg-paper-100 px-4 py-3 sm:block"></div>
          <div class="hidden border-b border-l border-line bg-paper-100 px-4 py-3 sm:block">
            <p class="th">Before — scattered</p>
          </div>
          <div class="hidden border-b border-l border-line bg-match-50 px-4 py-3 sm:block">
            <p class="font-mono text-[10.5px] font-medium tracking-[0.14em] text-match-700 uppercase">After — reconciled</p>
          </div>
        </div>
        {
          beforeAfter.map(([label, before, after]) => (
            <div class="grid border-t border-line first:border-t-0 sm:grid-cols-[0.9fr_1.4fr_1.4fr]">
              <div class="px-4 pt-4 font-mono text-[10.5px] tracking-[0.14em] text-ink/45 uppercase sm:border-r sm:border-line sm:py-4 sm:pt-4">
                {label}
              </div>
              <div class="body-text px-4 pt-3 pb-1 sm:border-r sm:border-line sm:py-4">{before}</div>
              <div class="body-text px-4 pt-1 pb-4 text-ink sm:py-4">{after}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS (short) ============ -->
  <section class="border-y border-line bg-ink-950 py-20 lg:py-24">
    <div class="container-x">
      <SectionHead
        index="04"
        eyebrow="The engagement"
        title="Four business days, start to findings"
        sub="A disciplined, pre-scoped process — the delivery clock starts only when your clean, agreed inputs arrive."
        dark
      />
      <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-paper-50/12 bg-paper-50/10 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { day: 'Day 0', title: 'Sign & scope', body: 'One-page mutual NDA, fixed-scope SOW, advance payment. We agree the exact question and the two files.' },
            { day: 'Day 1', title: 'Feasibility gate', body: 'We inspect your exports. If files are corrupted or missing join keys, we pause and tell you — the SLA clock waits.' },
            { day: 'Days 2–3', title: 'Match & verify', body: 'Deterministic matching offline, then manual verification of every large variance against source records.' },
            { day: 'Day 4', title: 'Walkthrough', body: 'A 30-minute executive session: matched %, exception value, what each finding means, and a fixed-price automation roadmap.' },
          ].map((s) => (
            <div class="bg-ink-900 p-6">
              <p class="font-mono text-[11px] tracking-[0.2em] text-match-300 uppercase">{s.day}</p>
              <h3 class="font-display mt-3 text-lg font-semibold text-paper-50">{s.title}</h3>
              <p class="body-dark mt-2.5 text-[13.5px]">{s.body}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8">
        <a href="/how-it-works" class="btn-dark">The full process, step by step</a>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- ============ PROOF TEASER ============ -->
  <section class="py-20 lg:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
      <div>
        <SectionHead
          index="05"
          eyebrow="Proof, not promises"
          title="See the deliverable before you spend a rupee"
          sub="Most agencies show dashboards. We show the exception register — the actual document you receive, built on synthetic data that mirrors a real distributor’s August."
        />
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/proof" class="btn-primary">Open the sample deliverables</a>
          <a href="/contact" class="btn-secondary">Or just ask us anything</a>
        </div>
      </div>
      <div class="relative">
        <div class="absolute -top-3 -left-3 hidden h-full w-full rounded-lg border border-line lg:block" aria-hidden="true"></div>
        <div class="relative">
          <MiniRegister compact={false} />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHO ============ -->
  <section class="border-y border-line bg-paper-100 py-20 lg:py-24">
    <div class="container-x">
      <SectionHead
        index="06"
        eyebrow="Who this is for"
        title="Built for businesses where goods and money move separately"
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          [
            { icon: 'building', title: 'Distributors & stockists', body: 'Industrial, electrical, pumps, fasteners, hardware. Multi-godown, Tally + dispatch trackers, dealer networks.', note: 'Primary practice' },
            { icon: 'briefcase', title: 'SME manufacturers', body: 'Engineering, textiles, auto components. Tally on one side, shop-floor and job-work sheets on the other.', note: 'Secondary practice' },
            { icon: 'book', title: 'CA & bookkeeping firms', body: 'White-label client data cleanup and pre-audit scrubbing, delivered under your brand, at wholesale rates.', note: 'Partner channel' },
          ].map((s) => (
            <div class="card card-pad">
              <Icon name={s.icon} class="h-6 w-6 text-match-700" />
              <h3 class="display-3 mt-4">{s.title}</h3>
              <p class="body-text mt-3">{s.body}</p>
              <p class="mt-4 font-mono text-[10.5px] tracking-[0.18em] text-ink/45 uppercase">{s.note}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8">
        <a href="/who-we-help" class="btn-secondary">Full segment details — and who we can’t help</a>
      </div>
    </div>
  </section>

  <!-- ============ FAQ TEASER ============ -->
  <section class="py-20 lg:py-24">
    <div class="container-x max-w-3xl">
      <SectionHead index="07" eyebrow="Fair questions" title="The objections we hear first" />
      <div class="mt-10 space-y-4">
        {
          faqs.map((f) => (
            <div class="card card-pad">
              <h3 class="display-3">{f.q}</h3>
              <p class="body-text mt-3">{f.a}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8">
        <a href="/faq" class="btn-secondary">All answers, plainly</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
