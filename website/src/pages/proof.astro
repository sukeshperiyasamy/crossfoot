---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import MiniRegister from '../components/MiniRegister.astro';

const scenarios = [
  {
    status: 'Exact match',
    ref: 'DC-1001 · ₹42,800',
    title: 'Exact match',
    body: 'DC-1001 (19 Aug, ₹42,800) ties out to invoice with identical SKU, date and quantity. The clean control every other row is measured against.',
    badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-300',
    dotClass: 'bg-emerald-600',
    borderClass: 'border-t-4 border-t-emerald-600',
    footerBg: 'bg-emerald-50/50 border-emerald-100 text-emerald-800',
    footerText: 'Verified clean control',
    footerMeta: 'Δ ₹0',
    isCta: false,
  },
  {
    status: 'Unbilled dispatch',
    ref: 'DC-1045 · ₹84,200',
    title: 'Unbilled dispatch',
    body: 'DC-1045 left the godown on 26 Aug. No invoice exists in August or September. Cash risk: ₹84,200 sitting unbilled for 9 days — flagged automatically.',
    badgeClass: 'bg-rose-50 text-rose-800 border-rose-300',
    dotClass: 'bg-rose-600',
    borderClass: 'border-t-4 border-t-rose-600',
    footerBg: 'bg-rose-50/50 border-rose-100 text-rose-800',
    footerText: '₹84,200 cash risk',
    footerMeta: '9 days unbilled',
    isCta: false,
  },
  {
    status: 'Quantity variance',
    ref: 'DC-1080 · 50 vs 40',
    title: 'Quantity variance',
    body: 'DC-1080 dispatched 50 units; the invoice billed 40. Either a short shipment, a billing error, or an unrecorded return — each has a different owner, and now a paper trail.',
    badgeClass: 'bg-amber-50 text-amber-900 border-amber-300',
    dotClass: 'bg-amber-500',
    borderClass: 'border-t-4 border-t-amber-500',
    footerBg: 'bg-amber-50/50 border-amber-100 text-amber-900',
    footerText: '10 units variance',
    footerMeta: 'Paper trail created',
    isCta: false,
  },
  {
    status: 'Timing lag',
    ref: 'DC-1112 · 5-Day Lag',
    title: 'Timing lag',
    body: 'DC-1112 dispatched 31 Aug, billed 05 Sep. Legitimate — but only because the register proves it. Without the proof it reads exactly like a leak.',
    badgeClass: 'bg-sky-50 text-sky-800 border-sky-300',
    dotClass: 'bg-sky-600',
    borderClass: 'border-t-4 border-t-sky-600',
    footerBg: 'bg-sky-50/50 border-sky-100 text-sky-800',
    footerText: 'Legitimate timing lag',
    footerMeta: 'Proven nil leak',
    isCta: false,
  },
  {
    status: 'Duplicate ref',
    ref: '2 Invoices · 1 Challan',
    title: 'Duplicate reference',
    body: 'Two invoices cite the same dispatch challan. One of them is wrong, and the register shows which rows collided.',
    badgeClass: 'bg-purple-50 text-purple-800 border-purple-300',
    dotClass: 'bg-purple-600',
    borderClass: 'border-t-4 border-t-purple-600',
    footerBg: 'bg-purple-50/50 border-purple-100 text-purple-800',
    footerText: 'Collision isolated',
    footerMeta: 'Double-bill prevented',
    isCta: false,
  },
  {
    status: 'Your turn',
    ref: 'Dispatch + Tally',
    title: 'Your turn',
    body: 'Imagine your own last month in this table. The two files we need are already sitting in your system — the dispatch register and the Tally sales export.',
    badgeClass: 'bg-match-100 text-match-800 border-match-300',
    dotClass: 'bg-match-600',
    borderClass: 'border-t-4 border-t-match-600',
    footerBg: 'bg-match-50/80 border-match-200 text-match-900',
    footerText: '4-day turnaround',
    footerMeta: '₹1,999 + GST',
    isCta: true,
  },
];
---

<Base
  title="Sample Deliverables — Exception Register & Executive Summary | Crossfoot"
  description="See exactly what a Crossfoot diagnostic delivers: a traceable exception register with source-row references, engineered discrepancy scenarios, and a one-page executive summary. Synthetic demonstration data."
>
  <section class="border-b border-line bg-paper-100">
    <div class="container-x py-16 sm:py-20">
      <p class="eyebrow">Sample deliverables</p>
      <h1 class="display-1 mt-5 max-w-3xl">The actual documents. Synthetic data.</h1>
      <p class="lead mt-6 max-w-2xl">
        Client records are never shown publicly — that is the entire point of our confidentiality
        practice. So everything here is a demonstration prototype built on synthetic data that mirrors a
        ₹25-crore distributor’s August: 1,200 dispatch rows against 1,150 invoices, with five engineered
        discrepancy types.
      </p>
      <div class="mt-6 flex items-center gap-2">
        <Icon name="alert" class="h-4 w-4 text-timing-700" />
        <p class="font-mono text-[11px] tracking-[0.14em] text-timing-700 uppercase">
          Demonstration prototypes — all figures synthetic
        </p>
      </div>
    </div>
  </section>

  <!-- Full register -->
  <section class="py-20 lg:py-24">
    <div class="container-x">
      <SectionHead
        index="01"
        eyebrow="Deliverable 3 of 7"
        title="The exception register"
        sub="Every row is either matched or flagged — and every flag carries its source references. This is the document your team argues from, instead of arguing about."
      />
      <div class="mt-12">
        <MiniRegister full />
      </div>
      <div class="mt-6 flex flex-wrap gap-6">
        <span class="flex items-center gap-2 text-[12.5px] text-ink/60">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-match-600"></span> Matched — verified against source
        </span>
        <span class="flex items-center gap-2 text-[12.5px] text-ink/60">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-exception-600"></span> Exception — requires investigation
        </span>
        <span class="flex items-center gap-2 text-[12.5px] text-ink/60">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-timing-700"></span> Timing — legitimate lag, proven
        </span>
      </div>
    </div>
  </section>

  <!-- Scenarios -->
  <section class="border-y border-line bg-paper-100 py-20 lg:py-24">
    <div class="container-x">
      <SectionHead
        index="02"
        eyebrow="What the engine catches"
        title="Five discrepancy types, engineered into the demo"
        sub="The synthetic dataset plants deliberate errors. The pipeline must find every one — or the demo fails. That standard is what ships to your live data."
      />
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          scenarios.map((s) => (
            <div
              class:list={[
                'h-full flex flex-col justify-between overflow-hidden rounded-lg border bg-white shadow-xs transition-all duration-150 hover:shadow-md',
                s.borderClass,
                s.isCta ? 'border-match-200 bg-match-50/25' : 'border-line',
              ]}
            >
              <div class="p-6 pb-5 flex flex-col flex-1">
                <div class="h-10 flex items-center justify-between gap-2 pb-3.5 border-b border-line/60">
                  <span
                    class:list={[
                      'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[10px] font-semibold tracking-wider uppercase whitespace-nowrap shrink-0',
                      s.badgeClass,
                    ]}
                  >
                    <span class:list={['h-1.5 w-1.5 rounded-full shrink-0', s.dotClass]}></span>
                    {s.status}
                  </span>
                  <span class="font-mono text-[10.5px] font-medium tracking-tight text-ink/60 bg-paper-100 px-2 py-0.5 rounded border border-line/60 whitespace-nowrap shrink-0">
                    {s.ref}
                  </span>
                </div>
                <h3 class="font-display text-lg font-bold tracking-tight text-ink mt-4">
                  {s.title}
                </h3>
                <p class="body-text mt-2.5 text-[13.5px] leading-relaxed text-ink/75 flex-1">
                  {s.body}
                </p>
              </div>

              <div
                class:list={[
                  'h-12 px-5 border-t flex items-center justify-between text-xs font-mono',
                  s.footerBg,
                ]}
              >
                {s.isCta ? (
                  <a
                    href="/contact"
                    class="btn btn-primary w-full h-8 text-[11px] font-bold tracking-wide uppercase flex items-center justify-center gap-1.5 shadow-xs whitespace-nowrap"
                  >
                    Book Diagnostic (₹1,999) →
                  </a>
                ) : (
                  <>
                    <span class="font-medium flex items-center gap-1.5 whitespace-nowrap">
                      <span class:list={['h-1.5 w-1.5 rounded-full shrink-0', s.dotClass]}></span>
                      {s.footerText}
                    </span>
                    <span class="text-ink/45 text-[11px] whitespace-nowrap">{s.footerMeta}</span>
                  </>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Exec summary mock + video -->
  <section class="py-20 lg:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHead
          index="03"
          eyebrow="Deliverable 5 of 7"
          title="The one-page executive summary"
        />
        <div class="card mt-8 p-6 sm:p-8">
          <div class="flex items-baseline justify-between border-b border-line pb-4">
            <p class="font-display text-lg font-semibold text-ink">Reconciliation Summary — August</p>
            <span class="chip chip-ink">Synthetic</span>
          </div>
          <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-5">
            <div>
              <dt class="font-mono text-[10.5px] tracking-[0.16em] text-ink/45 uppercase">Records examined</dt>
              <dd class="font-display mt-1 text-2xl font-semibold text-ink">2,350</dd>
            </div>
            <div>
              <dt class="font-mono text-[10.5px] tracking-[0.16em] text-ink/45 uppercase">Matched cleanly</dt>
              <dd class="font-display mt-1 text-2xl font-semibold text-match-700">84.2%</dd>
            </div>
            <div>
              <dt class="font-mono text-[10.5px] tracking-[0.16em] text-ink/45 uppercase">Exception value</dt>
              <dd class="font-display mt-1 text-2xl font-semibold text-exception-700">₹1,07,900</dd>
            </div>
            <div>
              <dt class="font-mono text-[10.5px] tracking-[0.16em] text-ink/45 uppercase">Items flagged</dt>
              <dd class="font-display mt-1 text-2xl font-semibold text-ink">8</dd>
            </div>
          </dl>
          <div class="mt-6 space-y-2.5 border-t border-line pt-5">
            <p class="flex items-center justify-between text-[13.5px]">
              <span class="text-ink/70">Category A — dispatched, unbilled</span>
              <span class="font-mono font-medium text-exception-700">3 items · ₹1,26,350 gross</span>
            </p>
            <p class="flex items-center justify-between text-[13.5px]">
              <span class="text-ink/70">Category B — quantity / rate variance</span>
              <span class="font-mono font-medium text-timing-700">1 item · ₹4,200</span>
            </p>
            <p class="flex items-center justify-between text-[13.5px]">
              <span class="text-ink/70">Category C — timing lags, verified</span>
              <span class="font-mono font-medium text-ink/60">4 items · nil leakage</span>
            </p>
          </div>
          <p class="mt-6 border-t border-line pt-4 text-[11.5px] leading-5 text-ink/45">
            Management decision aid based on client-supplied records. Not a statutory audit, tax opinion,
            or certification of accounts.
          </p>
        </div>
      </div>

      <div>
        <SectionHead
          index="04"
          eyebrow="The 60-second walkthrough"
          title="Watch one-click refresh"
          sub="Twelve messy monthly files go in; a reconciled, exception-flagged dashboard comes out. Recorded on the synthetic demo."
        />
        <!-- VIDEO EMBED CONTAINER: Replace this block with your Loom/YouTube iframe once recorded -->
        <div class="card mt-8 flex aspect-video flex-col items-center justify-center bg-ink-900 p-8 text-center text-paper-50">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-forest-700/80 text-white shadow-md">
            <Icon name="refresh" class="h-6 w-6 text-match-300" />
          </div>
          <p class="mt-4 font-display text-lg font-semibold text-paper-50">
            Live 5-Minute Synthetic Walkthrough
          </p>
          <p class="body-dark mx-auto mt-2 max-w-sm text-[13px] text-paper-50/70">
            Watch 2,350 raw dispatch and Tally rows get matched in real time, isolating unbilled challans and quantity shortfalls with row-level proof.
          </p>
          <a href="/contact" class="btn btn-sm btn-primary mt-5">
            Schedule Live Demo (15 Mins) →
          </a>
        </div>
        <p class="body-text mt-4 text-[13px]">
          Prefer it live? The same five-minute demonstration runs on every first call — on synthetic data,
          never yours.
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Now picture your August in that register."
    sub="Book the call, describe your two stubborn files, and we will tell you honestly whether a diagnostic is worth running."
  />
</Base>
