---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
---

<Base
  title="Contact — Book a 15-Minute Call | Crossfoot"
  description="Book a 15-minute call with Crossfoot, or send your questions in writing. No pitch — tell us which two records in your business refuse to agree."
>
  <section class="border-b border-line bg-paper-100">
    <div class="container-x py-16 sm:py-20">
      <p class="eyebrow">Contact</p>
      <h1 class="display-1 mt-5 max-w-3xl">Fifteen minutes. No pitch. Bring your two stubborn files.</h1>
      <p class="lead mt-6 max-w-2xl">
        The first call is a qualification conversation, not a sales one: you describe your month-end
        reality, we tell you honestly whether a diagnostic would find anything worth paying for.
      </p>
    </div>
  </section>

  <section class="py-20 lg:py-24">
    <div class="container-x grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
      <!-- Left: booking + direct -->
      <div>
        <SectionHead index="01" eyebrow="Fastest path" title="Book a 15-minute call" />
        <!-- TODO: replace with your real Calendly inline embed:
        <div class="calendly-inline-widget" data-url="https://calendly.com/YOUR-HANDLE/15min" style="min-width:320px;height:700px;"></div>
        <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
        -->
        <div class="card mt-8 flex min-h-[220px] flex-col items-start justify-center gap-4 p-8">
          <Icon name="calendar" class="h-7 w-7 text-match-700" />
          <div>
            <p class="font-display text-lg font-semibold text-ink">Calendar opens here</p>
            <p class="body-text mt-1.5 max-w-md">
              Paste your Calendly inline embed in <code class="font-mono text-[13px]">src/pages/contact.astro</code>
              (the marked TODO block), or use the button below with your live link.
            </p>
          </div>
          <a href="https://calendly.com/YOUR-HANDLE/15min" class="btn-primary" rel="noopener">
            Open the calendar
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="card p-5">
            <p class="font-mono text-[10.5px] tracking-[0.18em] text-ink/45 uppercase">Email</p>
            <!-- TODO: set your real domain email -->
            <p class="mt-2 text-[14px] font-medium text-ink">hello@crossfoot.in</p>
            <p class="mt-1 text-[12.5px] text-ink/55">Answered within 1 business day</p>
          </div>
          <div class="card p-5">
            <p class="font-mono text-[10.5px] tracking-[0.18em] text-ink/45 uppercase">Phone / WhatsApp</p>
            <!-- TODO: set your real number -->
            <p class="mt-2 text-[14px] font-medium text-ink">+91 · add your number</p>
            <p class="mt-1 text-[12.5px] text-ink/55">For scheduling only — never bulk messaging</p>
          </div>
        </div>
        <p class="mt-4 font-mono text-[11px] tracking-[0.14em] text-ink/50 uppercase">
          Coimbatore · Chennai · Remote across India
        </p>
      </div>

      <!-- Right: form -->
      <div>
        <SectionHead index="02" eyebrow="Prefer writing?" title="Send the details instead" />
        <form
          name="enquiry"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/thanks"
          class="card mt-8 p-6 sm:p-8"
        >
          <input type="hidden" name="form-name" value="enquiry" />
          <p class="hidden">
            <label>Don’t fill this out: <input name="bot-field" /></label>
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="font-mono text-[10.5px] tracking-[0.16em] text-ink/50 uppercase">Your name *</span>
              <input
                type="text"
                name="name"
                required
                class="mt-2 w-full rounded-md border border-line bg-paper-50 px-4 py-3 text-[14px] text-ink outline-none focus:border-match-600 focus:ring-2 focus:ring-match-100"
              />
            </label>
            <label class="block">
              <span class="font-mono text-[10.5px] tracking-[0.16em] text-ink/50 uppercase">Business name *</span>
              <input
                type="text"
                name="business"
                required
                class="mt-2 w-full rounded-md border border-line bg-paper-50 px-4 py-3 text-[14px] text-ink outline-none focus:border-match-600 focus:ring-2 focus:ring-match-100"
              />
            </label>
            <label class="block">
              <span class="font-mono text-[10.5px] tracking-[0.16em] text-ink/50 uppercase">Email *</span>
              <input
                type="email"
                name="email"
                required
                class="mt-2 w-full rounded-md border border-line bg-paper-50 px-4 py-3 text-[14px] text-ink outline-none focus:border-match-600 focus:ring-2 focus:ring-match-100"
              />
            </label>
            <label class="block">
              <span class="font-mono text-[10.5px] tracking-[0.16em] text-ink/50 uppercase">Phone</span>
              <input
                type="tel"
                name="phone"
                class="mt-2 w-full rounded-md border border-line bg-paper-50 px-4 py-3 text-[14px] text-ink outline-none focus:border-match-600 focus:ring-2 focus:ring-match-100"
              />
            </label>
          </div>

          <label class="mt-5 block">
            <span class="font-mono text-[10.5px] tracking-[0.16em] text-ink/50 uppercase">
              Which two records in your business refuse to agree? *
            </span>
            <textarea
              name="message"
              rows="5"
              required
              placeholder="e.g., Warehouse dispatch register vs. Tally sales — they never match at month-end and one clerk spends days checking…"
              class="mt-2 w-full rounded-md border border-line bg-paper-50 px-4 py-3 text-[14px] text-ink outline-none placeholder:text-ink/35 focus:border-match-600 focus:ring-2 focus:ring-match-100"
            ></textarea>
          </label>

          <label class="mt-5 flex items-start gap-3">
            <input type="checkbox" name="consent" required class="mt-1 h-4 w-4 shrink-0 accent-[#115c3e]" />
            <span class="text-[12.5px] leading-5 text-ink/60">
              I consent to Crossfoot storing these details to respond to my enquiry, per the
              <a href="/privacy" class="underline decoration-line underline-offset-2 hover:text-ink">privacy policy</a>. *
            </span>
          </label>

          <button type="submit" class="btn-primary mt-6 w-full sm:w-auto">
            Send enquiry
            <Icon name="arrow-right" class="h-4 w-4" />
          </button>
          <p class="mt-4 text-[12px] leading-5 text-ink/45">
            Please don’t attach confidential files yet. Exports change hands only after the mutual NDA is signed.
          </p>
        </form>
      </div>
    </div>
  </section>
</Base>
