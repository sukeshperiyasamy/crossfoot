---
import Icon from './Icon.astro';

const items = [
  { icon: 'file-check', label: 'Mutual NDA before any file' },
  { icon: 'lock', label: '100% offline, air-gapped processing' },
  { icon: 'eye-off', label: 'Zero public AI tools' },
  { icon: 'shield', label: 'Read-only — we never touch your Tally' },
  { icon: 'trash', label: 'Files deleted 14 days after handover' },
  { icon: 'scale', label: 'Not a statutory audit' },
];
---

<section aria-label="Operating guarantees" class="border-y border-line bg-paper-100">
  <div class="container-x grid grid-cols-2 gap-x-6 gap-y-4 py-5 sm:grid-cols-3 lg:grid-cols-6">
    {
      items.map((item) => (
        <div class="flex items-start gap-2.5">
          <Icon name={item.icon} class="mt-0.5 h-4 w-4 shrink-0 text-match-700" />
          <span class="text-[12.5px] leading-5 font-medium text-ink/70">{item.label}</span>
        </div>
      ))
    }
  </div>
</section>
