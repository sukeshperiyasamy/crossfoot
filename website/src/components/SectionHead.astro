---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  sub?: string;
  dark?: boolean;
  align?: 'left' | 'center';
}
const { index, eyebrow, title, sub, dark = false, align = 'left' } = Astro.props;
---

<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center']}>
  <p class:list={[dark ? 'eyebrow-dark' : 'eyebrow']}>{index} · {eyebrow}</p>
  <h2 class:list={['display-2 mt-4', dark && 'text-paper-50']}>{title}</h2>
  {sub && <p class:list={['lead mt-4', dark && 'text-paper-50/70']}>{sub}</p>}
</div>
